{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
