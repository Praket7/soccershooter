{
  "name": "soccershooter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "node tools/security/check-authoritative-random.mjs && node tools/security/check-private-imports.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run packages/sim/src/football/strikePlanner.test.ts packages/sim/src/football/feelRegression.test.ts packages/sim/src/football/runningStrikeProfessional.test.ts tools/perf/strike-transition-calibration.test.ts --reporter=verbose",
    "test:determinism": "vitest run packages/sim/src/determinism.test.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "determinism:headless": "tsx tools/perf/run-determinism.ts",
    "dribble:calibration": "tsx tools/perf/dribble-calibration.ts",
    "strike:calibration": "tsx tools/perf/strike-transition-calibration.ts",
    "ball:fuzz": "tsx tools/perf/ball-fuzz.ts --launches=1000000 --substeps=4 --seed=309777",
    "football:fuzz": "tsx tools/perf/football-fuzz.ts --cases=250000 --seed=5904133",
    "football:balance": "tsx tools/balance/exploitBots.ts",
    "bots:tournament": "tsx tools/balance/tournament.ts --possessions=5000 --seed=0x51a6e006",
    "bots:adaptive-tournament": "tsx tools/balance/adaptiveTournament.ts --scenarios=2000 --seed=0x7007a11",
    "bots:learning-lab": "tsx tools/balance/learning-lab/harness.ts --training=2200 --episodes=600 --seed=0x7007cafe",
    "build:web": "node tools/security/check-content-mode.mjs --production && node tools/security/check-private-imports.mjs && pnpm --filter @soccershooter/web build",
    "build:server": "pnpm --filter @soccershooter/server build",
    "build": "pnpm run build:server && pnpm run build:web"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
